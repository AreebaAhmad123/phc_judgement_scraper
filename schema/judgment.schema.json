{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "External Judgment Metadata",
  "type": "object",
  "required": [
    "source_file", "fileName", "Court Name", "courtType",
    "Case Title", "Case Number", "reference_url", "content", "source_url"
  ],
  "properties": {
    "source_file": { "type": "string" },
    "fileName": { "type": "string" },
    "Page count": { "type": ["null"] },
    "Court Name": { "type": "string" },
    "courtType": { "type": "string" },
    "Case Title": { "type": "string" },
    "Case Number": { "type": "string" },
    "citation_year": { "type": ["integer", "null"] },
    "citation_journal": { "type": ["string", "null"] },
    "citation_page_number": { "type": ["string", "null"] },
    "articles_sections_cited": { "type": "array", "items": { "type": "string" } },
    "statutes_mentioned": { "type": "array", "items": { "type": "string" } },
    "key_legal_issues": { "type": "array", "items": { "type": "string" } },
    "precedents_cited": { "type": "array", "items": { "type": "string" } },
    "legal_keywords": { "type": "array", "items": { "type": "string" } },
    "content": { "type": "string" },
    "source_url": { "type": "string" }
  },
  "additionalProperties": true
}