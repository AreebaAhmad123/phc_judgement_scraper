# Copy this file to .env and fill in real values. .env must NEVER be
# committed - it's already in .gitignore, keep it that way.

# --- Weaviate -----------------------------------------------------------
# Local docker-compose (see docker-compose.weaviate.yml): leave as-is.
# Weaviate Cloud: set to your cluster URL and set WEAVIATE_API_KEY.
WEAVIATE_URL=http://localhost:8080
WEAVIATE_API_KEY=

# --- LLM (grounded answer generation) ------------------------------------
# Groq (https://console.groq.com) is free/low-cost and OpenAI-compatible.
# Swap provider by changing llm.py + these two values if you'd rather use
# something else - nothing else in the codebase assumes Groq specifically.
LLM_API_KEY=your_key_here
LLM_MODEL=llama-3.3-70b-versatile

# --- Embeddings (safe to leave as default) --------------------------------
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2

# --- Google Drive (public view-only PDF links) ----------------------------
# OAuth as yourself, not a service account - see README.md "Google Drive
# setup" for the one-time `python gdrive_oauth_setup.py` step this needs
# before ingestion will work.
GOOGLE_OAUTH_CLIENT_SECRET_FILE=client_secret.json
GOOGLE_OAUTH_TOKEN_FILE=token.json
GOOGLE_DRIVE_FOLDER_ID=your_folder_id_here

# --- OCR fallback for scanned PDFs (safe to leave as default) ------------
OCR_ENABLED=true
OCR_LANGUAGE=eng
OCR_DPI=300

QUERY_CLASSIFIER_MODEL=llama-3.1-8b-instant
RERANKER_MODEL_NAME=cross-encoder/ms-marco-MiniLM-L-6-v2

# --- LLM metadata extraction (Section 4 fields with no listing-page
# source: judge names, disposition, cited law, summaries, etc.) --------
# Safe to leave as default; METADATA_LLM_MAX_CHARS caps how much of a
# judgment's markdown is sent per extraction call (head+tail, not just
# head - see llm_metadata_extractor.py).
METADATA_LLM_MODEL=llama-3.3-70b-versatile
METADATA_LLM_MAX_CHARS=20000


# --- AWS S3 (mandatory delivery) ----------------------------------------
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
S3_BUCKET_NAME=

# --- External Judgment API (MongoDB via REST) -----------------------------
EXTERNAL_JUDGMENT_API_BASE_URL=https://chat.pakistanlawbot.com
EXTERNAL_JUDGMENT_API_KEY=

# --- Court selection (extensible; only "phc" implemented now) -------------
COURT_ID=phc

# --- API service: auth, rate limiting, CORS --------------------------------
# REQUIRE_API_KEY=false is for local dev only, against a service with no
# public exposure - never set it false anywhere the port is reachable
# from outside your machine. When true (the default), every request to
# /chat and /ingest/* must send this exact value in an X-API-Key header.
REQUIRE_API_KEY=true
API_KEY=generate_a_long_random_value_here

# Per-client-IP throttle on the two endpoints that trigger paid/quota-
# limited calls downstream (Groq, embeddings, Weaviate, S3). Format is
# whatever the `limits` package accepts, e.g. "30/minute", "500/day".
CHAT_RATE_LIMIT=30/minute
INGEST_RATE_LIMIT=2/minute

# Comma-separated allowed origins for a browser-based frontend calling
# this API directly. Leave empty (the default) until you actually have
# one - never set to "*" since this API sits behind an API key.
CORS_ALLOWED_ORIGINS=


# --- Scraper identity / etiquette ------------------------------------------
# REQUIRED before running against the live site for real: a real contact
# email goes in the honest User-Agent (see DECISIONS.md "Etiquette").
# IDENTIFY_AS_BROWSER=true only if the honest UA gets WAF-blocked.
CONTACT_EMAIL=your_real_email@example.com
REPO_URL=https://github.com/AreebaAhmad123/phc_judgement_scraper
IDENTIFY_AS_BROWSER=false

